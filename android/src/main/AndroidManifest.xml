<?xml version="1.0" encoding="utf-8"?>
<!-- Fase 6. INTERNET: falar com o servidor de ranking. usesCleartextTraffic: o servidor de desenvolvimento usa HTTP
     (sem TLS); publicado, ele deve ficar atrás de HTTPS (veja servidor/PUBLICACAO.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- Sem orientação fixa: retrato e paisagem (o layout se adapta, e o Android 16 ignora orientação fixa).
             configChanges: girar a tela não recria a Activity; a libGDX só chama resize(). -->
        <activity
            android:name=".AndroidLauncher"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
