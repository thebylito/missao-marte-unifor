# Copie para .env (que o Git ignora) e preencha. Gere um segredo com:  openssl rand -base64 48
# Vazio, o servidor sobe com um segredo temporário (os tokens deixam de valer a cada reinício) e avisa no log.
MISSAOMARTE_JWT_SEGREDO=
# Porta no computador (a do contêiner é sempre 8080)
PORTA=8080
# Endereço público, só na publicação (usado pelo "Try it out" do Swagger). Vazio: http://localhost:8080
MISSAOMARTE_URL_PUBLICA=
# Senha do PostgreSQL do compose (banco e usuário missaomarte). Vazia: a de desenvolvimento do compose.yaml.
# Ela só vale na criação do volume "banco": para trocar depois, docker compose down -v (apaga os dados).
MISSAOMARTE_DB_SENHA=
# Ensaio da virada (DA-41): /dados/missaomarte copia o H2 do volume "dados" para o PostgreSQL vazio. Vazio: nada.
MISSAOMARTE_IMPORTAR_H2=
