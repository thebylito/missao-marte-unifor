{
    "openapi": "3.1.0",
    "info": {
        "title": "Miss\u00e3o Marte \u2014 servidor de ranking",
        "description": "Cadastro e login, hist\u00f3rico, moedas e skins, Horda, placares e painel de eventos. O canal WebSocket /ws/sombras est\u00e1 documentado em docs/api/contrato-horda.md.",
        "version": "5.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "desenvolvimento"
        }
    ],
    "security": [
        {
            "token": []
        }
    ],
    "paths": {
        "/api/jogadores/eu/skin": {
            "put": {
                "tags": [
                    "controlador-do-hangar"
                ],
                "operationId": "equipar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PedidoDeSkin"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SkinEquipada"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sessoes": {
            "post": {
                "tags": [
                    "controlador-de-sessoes"
                ],
                "operationId": "entrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credenciais"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/partidas": {
            "post": {
                "tags": [
                    "controlador-de-partidas"
                ],
                "operationId": "registrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroDePartida"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Partida registrada. Na Horda, repetir a mesma partida com o mesmo bilhete devolve o registro existente.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PartidaRegistrada"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados ou bilhete inv\u00e1lidos",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "HORDA_ENCERRADA",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "status": 409,
                                    "title": "Conflict",
                                    "detail": "a horda est\u00e1 encerrada",
                                    "motivo": "HORDA_ENCERRADA"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/partidas/inicio": {
            "post": {
                "tags": [
                    "controlador-de-partidas"
                ],
                "operationId": "iniciar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/InicioDePartida"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Bilhete emitido",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BilheteResposta"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Dados da partida inv\u00e1lidos",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "HORDA_ENCERRADA",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "status": 409,
                                    "title": "Conflict",
                                    "detail": "a horda est\u00e1 encerrada",
                                    "motivo": "HORDA_ENCERRADA"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/loja/compras": {
            "post": {
                "tags": [
                    "controlador-da-loja"
                ],
                "operationId": "comprar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PedidoDeSkin"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompraResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/jogadores": {
            "post": {
                "tags": [
                    "controlador-de-jogadores"
                ],
                "operationId": "cadastrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CadastroDeJogador"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/JogadorResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/eventos": {
            "post": {
                "tags": [
                    "controlador-de-eventos"
                ],
                "operationId": "disparar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Pedido"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "202": {
                        "description": "Evento agendado com aviso de 15 segundos"
                    },
                    "401": {
                        "description": "Token ausente ou inv\u00e1lido"
                    },
                    "403": {
                        "description": "Jogador sem acesso ao painel"
                    }
                }
            }
        },
        "/api/ranking": {
            "get": {
                "tags": [
                    "controlador-de-ranking"
                ],
                "operationId": "top10",
                "parameters": [
                    {
                        "name": "modo",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "CLASSICO",
                            "enum": [
                                "CLASSICO",
                                "PILOTAGEM",
                                "HORDA"
                            ]
                        }
                    },
                    {
                        "name": "horda",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PosicaoNoRanking"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/ranking/semanal": {
            "get": {
                "tags": [
                    "controlador-de-ranking"
                ],
                "operationId": "semanal",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Placar"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/partidas/minhas": {
            "get": {
                "tags": [
                    "controlador-de-partidas"
                ],
                "operationId": "minhas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PartidaResposta"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/loja": {
            "get": {
                "tags": [
                    "controlador-da-loja"
                ],
                "operationId": "catalogo",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Skin"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/jogadores/eu": {
            "get": {
                "tags": [
                    "controlador-de-jogadores"
                ],
                "operationId": "eu",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/JogadorResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/jogadores/eu/hangar": {
            "get": {
                "tags": [
                    "controlador-do-hangar"
                ],
                "operationId": "hangar",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Hangar"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/hordas/atual": {
            "get": {
                "tags": [
                    "controlador-de-hordas"
                ],
                "operationId": "atual",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/HordaAtual"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/ajustes": {
            "get": {
                "tags": [
                    "controlador-de-ajustes"
                ],
                "summary": "Ajustes da Pilotagem",
                "description": "Tanque, limites de pouso e asteroides por dificuldade, velocidade dos meteoros e dura\u00e7\u00e3o dos eventos, lidos das vari\u00e1veis MISSAOMARTE_AJUSTE_* na subida do servidor. A horda usa os ajustes gravados nela (descricao.ajustes em /api/hordas/atual).",
                "operationId": "ajustes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AjustesDeVoo"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "PedidoDeSkin": {
                "type": "object",
                "properties": {
                    "skin": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "skin"
                ]
            },
            "SkinEquipada": {
                "type": "object",
                "properties": {
                    "equipada": {
                        "type": "string"
                    }
                }
            },
            "Credenciais": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "minLength": 1
                    },
                    "senha": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "nome",
                    "senha"
                ]
            },
            "JogadorResposta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "criadoEm": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "TokenResposta": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "tipo": {
                        "type": "string"
                    },
                    "expiraEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "jogador": {
                        "$ref": "#/components/schemas/JogadorResposta"
                    }
                }
            },
            "RegistroDePartida": {
                "type": "object",
                "properties": {
                    "resultado": {
                        "type": "string",
                        "enum": [
                            "VITORIA",
                            "DERROTA",
                            "ABORTADA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 10000,
                        "minimum": 0
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 100,
                        "minimum": 0
                    },
                    "movimentos": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 1000000,
                        "minimum": 0
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64",
                        "maximum": 86400,
                        "minimum": 0
                    },
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM",
                            "HORDA"
                        ]
                    },
                    "bilhete": {
                        "type": "string",
                        "description": "Bilhete emitido no in\u00edcio da partida. Obrigat\u00f3rio no modo HORDA."
                    },
                    "horda": {
                        "type": "integer",
                        "format": "int64",
                        "description": "N\u00famero da horda. Obrigat\u00f3rio no modo HORDA."
                    },
                    "comAjustes": {
                        "type": "boolean",
                        "description": "O jogo segue os ajustes do servidor (DA-48). Na Pilotagem, com ajustes diferentes do padr\u00e3o, o resultado sem ele s\u00f3 vale se o bilhete foi emitido com o padr\u00e3o; sen\u00e3o, 409 JOGO_DESATUALIZADO."
                    }
                },
                "required": [
                    "dificuldade",
                    "movimentos",
                    "passageiros",
                    "pontos",
                    "resultado",
                    "tempoSegundos"
                ]
            },
            "ProblemDetail": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "format": "uri"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "instance": {
                        "type": "string",
                        "format": "uri"
                    },
                    "properties": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                }
            },
            "PartidaRegistrada": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "resultado": {
                        "type": "string",
                        "enum": [
                            "VITORIA",
                            "DERROTA",
                            "ABORTADA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "movimentos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "registradaEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM",
                            "HORDA"
                        ]
                    },
                    "moedasGanhas": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "saldo": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "colocacao": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "format": "int32",
                        "description": "Posi\u00e7\u00e3o do jogador no Top 10 da horda, ou null."
                    }
                }
            },
            "InicioDePartida": {
                "type": "object",
                "properties": {
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM",
                            "HORDA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "horda": {
                        "type": "integer",
                        "format": "int64",
                        "description": "N\u00famero da horda. Obrigat\u00f3rio no modo HORDA."
                    },
                    "comAjustes": {
                        "type": "boolean",
                        "description": "O jogo aplica os ajustes gravados na horda (DA-48). Sem ele, uma horda com ajustes diferentes do padr\u00e3o recusa o bilhete (409 JOGO_DESATUALIZADO)."
                    }
                },
                "required": [
                    "dificuldade"
                ]
            },
            "BilheteResposta": {
                "type": "object",
                "properties": {
                    "bilhete": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "validoAte": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "CompraResposta": {
                "type": "object",
                "properties": {
                    "saldo": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "skins": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "CadastroDeJogador": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 3,
                        "pattern": "[\\p{L}\\p{N} ._-]*"
                    },
                    "senha": {
                        "type": "string",
                        "maxLength": 72,
                        "minLength": 6
                    }
                },
                "required": [
                    "nome",
                    "senha"
                ]
            },
            "Pedido": {
                "type": "object",
                "properties": {
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "CHUVA_DE_METEOROS",
                            "TEMPESTADE",
                            "PANE_DE_GRAVIDADE",
                            "PASSAGEIRO_VIP"
                        ]
                    }
                },
                "required": [
                    "tipo"
                ]
            },
            "PosicaoNoRanking": {
                "type": "object",
                "properties": {
                    "posicao": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "registradaEm": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Placar": {
                "type": "object",
                "properties": {
                    "semana": {
                        "type": "string",
                        "format": "date"
                    },
                    "posicoes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Posicao"
                        }
                    }
                }
            },
            "Posicao": {
                "type": "object",
                "properties": {
                    "posicao": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "hordas": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "eventos": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "PartidaResposta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "resultado": {
                        "type": "string",
                        "enum": [
                            "VITORIA",
                            "DERROTA",
                            "ABORTADA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "movimentos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "registradaEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM",
                            "HORDA"
                        ]
                    }
                }
            },
            "Skin": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "linha": {
                        "type": "string"
                    },
                    "nivel": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "preco": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "Hangar": {
                "type": "object",
                "properties": {
                    "saldo": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "skins": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "equipada": {
                        "type": "string"
                    }
                }
            },
            "AjustesDaDificuldade": {
                "type": "object",
                "properties": {
                    "tanque": {
                        "type": "number",
                        "format": "double"
                    },
                    "quedaMaxima": {
                        "type": "number",
                        "format": "double"
                    },
