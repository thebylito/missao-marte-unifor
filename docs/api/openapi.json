{
    "openapi": "3.1.0",
    "info": {
        "title": "Miss\u00e3o Marte \u2014 servidor de ranking",
        "description": "Cadastro e login de jogadores (token JWT), hist\u00f3rico de partidas e ranking global Top 10. O servidor guarda pontua\u00e7\u00f5es; n\u00e3o executa o jogo.",
        "version": "5.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "desenvolvimento"
        }
    ],
    "security": [
        {
            "token": []
        }
    ],
    "paths": {
        "/api/jogadores/eu/skin": {
            "put": {
                "tags": [
                    "controlador-do-hangar"
                ],
                "operationId": "equipar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PedidoDeSkin"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SkinEquipada"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sessoes": {
            "post": {
                "tags": [
                    "controlador-de-sessoes"
                ],
                "operationId": "entrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credenciais"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/partidas": {
            "post": {
                "tags": [
                    "controlador-de-partidas"
                ],
                "operationId": "registrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroDePartida"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PartidaRegistrada"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/partidas/inicio": {
            "post": {
                "tags": [
                    "controlador-de-partidas"
                ],
                "operationId": "iniciar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/InicioDePartida"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BilheteResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/loja/compras": {
            "post": {
                "tags": [
                    "controlador-da-loja"
                ],
                "operationId": "comprar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PedidoDeSkin"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompraResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/jogadores": {
            "post": {
                "tags": [
                    "controlador-de-jogadores"
                ],
                "operationId": "cadastrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CadastroDeJogador"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/JogadorResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/ranking": {
            "get": {
                "tags": [
                    "controlador-de-ranking"
                ],
                "operationId": "top10",
                "parameters": [
                    {
                        "name": "modo",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "CLASSICO",
                            "enum": [
                                "CLASSICO",
                                "PILOTAGEM"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PosicaoNoRanking"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/partidas/minhas": {
            "get": {
                "tags": [
                    "controlador-de-partidas"
                ],
                "operationId": "minhas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PartidaResposta"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/loja": {
            "get": {
                "tags": [
                    "controlador-da-loja"
                ],
                "operationId": "catalogo",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Skin"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/jogadores/eu": {
            "get": {
                "tags": [
                    "controlador-de-jogadores"
                ],
                "operationId": "eu",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/JogadorResposta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/jogadores/eu/hangar": {
            "get": {
                "tags": [
                    "controlador-do-hangar"
                ],
                "operationId": "hangar",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Hangar"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PedidoDeSkin": {
                "type": "object",
                "properties": {
                    "skin": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "skin"
                ]
            },
            "SkinEquipada": {
                "type": "object",
                "properties": {
                    "equipada": {
                        "type": "string"
                    }
                }
            },
            "Credenciais": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "minLength": 1
                    },
                    "senha": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "nome",
                    "senha"
                ]
            },
            "JogadorResposta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "criadoEm": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "TokenResposta": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "tipo": {
                        "type": "string"
                    },
                    "expiraEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "jogador": {
                        "$ref": "#/components/schemas/JogadorResposta"
                    }
                }
            },
            "RegistroDePartida": {
                "type": "object",
                "properties": {
                    "resultado": {
                        "type": "string",
                        "enum": [
                            "VITORIA",
                            "DERROTA",
                            "ABORTADA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 10000,
                        "minimum": 0
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 100,
                        "minimum": 0
                    },
                    "movimentos": {
                        "type": "integer",
                        "format": "int32",
                        "maximum": 1000000,
                        "minimum": 0
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64",
                        "maximum": 86400,
                        "minimum": 0
                    },
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM"
                        ]
                    },
                    "bilhete": {
                        "type": "string"
                    }
                },
                "required": [
                    "dificuldade",
                    "movimentos",
                    "passageiros",
                    "pontos",
                    "resultado",
                    "tempoSegundos"
                ]
            },
            "PartidaRegistrada": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "resultado": {
                        "type": "string",
                        "enum": [
                            "VITORIA",
                            "DERROTA",
                            "ABORTADA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "movimentos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "registradaEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM"
                        ]
                    },
                    "moedasGanhas": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "saldo": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "InicioDePartida": {
                "type": "object",
                "properties": {
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    }
                },
                "required": [
                    "dificuldade"
                ]
            },
            "BilheteResposta": {
                "type": "object",
                "properties": {
                    "bilhete": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "validoAte": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "CompraResposta": {
                "type": "object",
                "properties": {
                    "saldo": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "skins": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "CadastroDeJogador": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 3,
                        "pattern": "[\\p{L}\\p{N} ._-]*"
                    },
                    "senha": {
                        "type": "string",
                        "maxLength": 72,
                        "minLength": 6
                    }
                },
                "required": [
                    "nome",
                    "senha"
                ]
            },
            "PosicaoNoRanking": {
                "type": "object",
                "properties": {
                    "posicao": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "registradaEm": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "PartidaResposta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "resultado": {
                        "type": "string",
                        "enum": [
                            "VITORIA",
                            "DERROTA",
                            "ABORTADA"
                        ]
                    },
                    "dificuldade": {
                        "type": "string",
                        "enum": [
                            "FACIL",
                            "MEDIO",
                            "DIFICIL"
                        ]
                    },
                    "pontos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "passageiros": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "movimentos": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tempoSegundos": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "registradaEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "modo": {
                        "type": "string",
                        "enum": [
                            "CLASSICO",
                            "PILOTAGEM"
                        ]
                    }
                }
            },
            "Skin": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "linha": {
                        "type": "string"
                    },
                    "nivel": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "preco": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "Hangar": {
                "type": "object",
                "properties": {
                    "saldo": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "skins": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "equipada": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "token": {
                "type": "http",
                "description": "O token devolvido por POST /api/sessoes",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
